{
  "name": "huifa-desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-renderer.cjs",
    "start": "npm run build && electron .",
